generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model booking {
  id       Int     @id @default(autoincrement())
  date     String  @db.VarChar(10)
  hour     String  @db.VarChar(8)
  clientId Int?    @map("client_id")
  statusId Int?    @map("status_id")
  users    users?  @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_client")
  status   status? @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_status")
}

model roles {
  id          Int     @id @default(autoincrement())
  name        String  @unique(map: "unique_role_name") @db.VarChar(100)
  description String? @db.VarChar(200)
  users       users[]
}

model status {
  id      Int       @id @default(autoincrement())
  name    String    @unique(map: "unique_status_name") @db.VarChar(12)
  booking booking[]
}

model users {
  id                 Int           @id @default(autoincrement())
  username           String        @db.VarChar
  email              String        @unique(map: "unique_user_email")
  password           String?
  isActive           Boolean       @default(false) @map("is_active")
  isGoogleAccount    Boolean       @default(false) @map("is_google_account")
  activationToken    String?       @unique(map: "unique_activation_token") @map("activation_token") @db.VarChar
  resetPasswordToken String?       @unique(map: "unique_reset_password_token") @map("reset_password_token") @db.VarChar
  roleId             Int?          @map("role_id")
  booking            booking[]
  roles              roles?        @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_roles")
  Reservation        Reservation[]
}

model ServiceType {
  id            Int      @id @default(autoincrement())
  name          String
  unitsRequired Int      @map("units_required")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("service_type")
}

model Reservation {
  id              Int               @id @default(autoincrement())
  clientId        Int               @map("client_id")
  serviceTypeId   Int               @map("service_type_id")
  reservationDate String            @map("reservation_date") // solo la fecha (puedes cortar la hora en la lógica)
  scheduledTime   String            @map("scheduled_time")
  status          ReservationStatus
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  client      users       @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reservation_client")

  @@map("reservation")
}

enum ReservationStatus {
  pendiente
  confirmada
  cancelada
  expirada
}

model GlobalScheduleConfig {
  id                Int      @id @default(autoincrement())
  defaultTotalUnits Int      @map("default_total_units")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("global_schedule_config")
}

model DailyScheduleConfiguration {
  id           Int      @id @default(autoincrement())
  scheduleDate DateTime @unique @map("scheduled_date") // solo fecha, ignora la hora 
  totalUnits   Int      @map("total_units")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("daily_schedule_configuration")
}

model UnitSetting {
  id                  Int      @id @default(autoincrement())
  unitDurationMinutes Int      @default(20) @map("unit_duration_minutes") //INFO: 1 unidad = 20 minutos por defecto
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@map("unit_setting")
}
