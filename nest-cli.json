  {
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
      "assets": [
        {
          "include": "./db",
          "watchAssets": true,
          "outDir": "dist"
        },
        {
          "include": "**/views/*",
          "watchAssets": true,
          "outDir": "dist/src/"
        },
        {
          "include": "**/templates/*",
          "watchAssets": true,
          "outDir": "dist/src/"
        }
      ],
      "deleteOutDir": true
    }
  }
